<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jalalidesk.jclockplus"
    android:versionCode="7"
    android:versionName="1.6">
    <uses-sdk android:minSdkVersion="16" android:targetSdkVersion="28" />
    <application android:label="@string/app_name" android:icon="@drawable/clock_icon"
        android:allowBackup="false" android:theme="@style/ClockTheme">
        <!-- Older hardware renderers can drop the scaled paths used for the digits. -->
        <activity android:configChanges="orientation|screenSize" android:name=".ClockActivity" android:exported="true"
            android:hardwareAccelerated="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
